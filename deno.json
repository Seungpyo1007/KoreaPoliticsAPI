{
  "tasks": {
    "validate": "deno run --allow-read --allow-run=git scripts/validate.ts",
    "status": "deno run --allow-read --allow-write=data/_verify --allow-run=git scripts/validate.ts --write-status",
    "test": "deno test --allow-read scripts/",
    "ci": "deno fmt --check && deno lint && deno task test && deno task validate"
  },
  "imports": {
    "ajv": "npm:ajv@8.17.1",
    "@std/assert": "jsr:@std/assert@1.0.13"
  },
  "fmt": {
    "lineWidth": 100,
    "include": [
      "scripts/",
      "deno.json"
    ]
  },
  "lint": {
    "include": [
      "scripts/"
    ]
  }
}
