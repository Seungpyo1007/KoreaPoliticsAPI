{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Seungpyo1007/KoreaPoliticsAPI/schema/common.json",
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "url": { "type": "string", "pattern": "^https?://[^\\s]+$" },
    "source_urls": {
      "type": "array",
      "items": { "$ref": "#/$defs/url" },
      "minItems": 1,
      "uniqueItems": true
    },
    "election_id": { "type": "string", "pattern": "^[0-9]{8}$" },
    "office_type": { "enum": ["assembly", "metro-head", "local-head"] },
    "office_ref": {
      "type": "string",
      "pattern": "^(assembly|metro-head|local-head)/[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "text": { "type": "string", "minLength": 1 },
    "verified": { "type": "boolean" },
    "checked_at": { "$ref": "#/$defs/date" },
    "note": { "type": "string" },
    "withdrawn": { "type": "boolean" },
    "withdrawn_reason": { "type": "string", "minLength": 1 }
  }
}
