{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Seungpyo1007/KoreaPoliticsAPI/schema/ruling_periods.json",
  "type": "object",
  "required": ["periods", "checked_at"],
  "additionalProperties": false,
  "properties": {
    "checked_at": { "$ref": "common.json#/$defs/checked_at" },
    "periods": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["starts_on", "ends_on", "party_id", "president", "source_urls"],
        "additionalProperties": false,
        "properties": {
          "starts_on": { "$ref": "common.json#/$defs/date" },
          "ends_on": { "oneOf": [{ "$ref": "common.json#/$defs/date" }, { "type": "null" }] },
          "party_id": { "oneOf": [{ "$ref": "common.json#/$defs/id" }, { "type": "null" }] },
          "president": { "$ref": "common.json#/$defs/text" },
          "acting": { "type": "boolean" },
          "source_urls": { "$ref": "common.json#/$defs/source_urls" },
          "verified": { "$ref": "common.json#/$defs/verified" },
          "note": { "$ref": "common.json#/$defs/note" }
        }
      }
    }
  }
}
