{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Seungpyo1007/KoreaPoliticsAPI/schema/assembly.json",
  "type": "object",
  "required": ["id", "number", "name", "starts_on", "ends_on", "seats", "elections", "results", "source_urls", "verified", "checked_at"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[0-9]+$" },
    "number": { "type": "integer", "minimum": 1 },
    "name": { "$ref": "common.json#/$defs/text" },
    "starts_on": { "$ref": "common.json#/$defs/date" },
    "ends_on": { "oneOf": [{ "$ref": "common.json#/$defs/date" }, { "type": "null" }] },
    "seats": { "type": "integer", "minimum": 1 },
    "elections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "date", "seats"],
        "additionalProperties": false,
        "properties": {
          "kind": { "oneOf": [{ "$ref": "common.json#/$defs/text" }, { "type": "null" }] },
          "date": { "$ref": "common.json#/$defs/date" },
          "seats": { "oneOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }] },
          "election_id": { "$ref": "common.json#/$defs/election_id" }
        }
      }
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["party_name", "vote_share", "seats", "proportional_seats"],
        "additionalProperties": false,
        "properties": {
          "chamber": { "$ref": "common.json#/$defs/text" },
          "party_name": { "$ref": "common.json#/$defs/text" },
          "vote_share": { "oneOf": [{ "type": "number", "minimum": 0, "maximum": 100 }, { "type": "null" }] },
          "seats": { "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] },
          "proportional_seats": { "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] }
        }
      }
    },
    "source_urls": { "$ref": "common.json#/$defs/source_urls" },
    "verified": { "$ref": "common.json#/$defs/verified" },
    "checked_at": { "$ref": "common.json#/$defs/checked_at" },
    "note": { "$ref": "common.json#/$defs/note" },
    "withdrawn": { "$ref": "common.json#/$defs/withdrawn" },
    "withdrawn_reason": { "$ref": "common.json#/$defs/withdrawn_reason" }
  }
}
