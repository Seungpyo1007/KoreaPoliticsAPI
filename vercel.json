{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "curl -fsSL https://deno.land/install.sh | sh -s -- -y v2.9.7",
  "buildCommand": "$HOME/.deno/bin/deno task api",
  "outputDirectory": "dist/api",
  "trailingSlash": false,
  "git": {
    "deploymentEnabled": {
      "main": true,
      "**": false
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/index.json" },
    { "source": "/v1/:path*", "destination": "/v1/:path*/index.json" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Content-Type", "value": "application/json; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=300, s-maxage=3600" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
